generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
}

model Job {
    id          String   @id @default(cuid())
    company     String
    role        String
    description String
    status      String   @default("SAVED")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
